# Copy this file to .env and fill in your own keys THERE, not here.
#
#   cp .env.example .env      →  keys go in .env
#
# This file is tracked by git and the repository is public: a key typed
# below is published the moment you push, and scrapers find it in minutes.
# .env is gitignored, which is why it is the one that holds real values.
# Leave every value here empty.

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice to narrate with. Pick a Turkish-capable voice in the ElevenLabs
# voice library and paste its ID here. Default below is "Rachel" (English
# sounding); replace it for a natural Turkish read.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# eleven_multilingual_v2 handles Turkish well and is cheap.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional overrides
OUTPUT_DIR=output
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
SHORTS_COUNT=5
SHORT_DURATION=90

# Optional background music. See README "Arka plan müziği" — Pixabay's API
# has no music endpoint, so this is not fetched automatically; drop mp3/wav
# files into MUSIC_DIR yourself and one is picked at random per video. Leave
# the folder empty (or missing) to produce videos with no background music,
# same as before this feature existed.
MUSIC_DIR=music
# Fraction of full volume, mixed under the narration. 0.15 is quiet by design
# — raise it only after checking narration is still clearly audible.
MUSIC_VOLUME=0.15

# Optional YouTube automatic upload. See README "YouTube otomatik yükleme".
# client_secret.json comes from Google Cloud Console (OAuth 2.0 Desktop app
# credential) — it is not an API key typed here, it's a file you download
# and place in the project folder yourself. youtube_token.json is created
# automatically after the first browser consent; never commit either file.
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN=youtube_token.json
# private | unlisted | public — defaults to private on purpose: nothing
# reviews unattended batch output before it would otherwise go live.
YOUTUBE_PRIVACY=private
# Upload the Shorts alongside the long video (true/false).
YOUTUBE_UPLOAD_SHORTS=true
